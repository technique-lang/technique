"r" Enter               # /1
"a, b, c" Enter         # <sample>
Enter*6                 # [1]/-1 [1]/-2 [2]/-1 [2]/-2 [3]/-1 [3]/-2
Enter*4                 # sample:/1 sample:/2 sample: /2
Up Up*25 Esc "e"        # at /3, review to the sample: Begin and ask again
Backspace*13 "c, a" Enter
Enter*4                 # [1]/-1 [1]/-2 [2]/-1 [2]/-2
Enter*5                 # sample:/1 sample:/2 sample: /3 survey:
